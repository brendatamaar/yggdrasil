# Yggdrasil settings. Every setting is optional.
# Copy to .env and uncomment what you need. Never commit .env.
#
# Tokens set here are used by ygg itself only. They are never passed to
# builds, dev servers, terminals, installs or agents, and never logged.
#
# The server settings below are read from ygg's environment (set them in your
# shell). The git host settings are also read from a ".env" file: see the
# last section.

# --- Server -----------------------------------------------------------------

# Listen address. Loopback IPs only (127.0.0.1 or ::1); remote access isn't
# available yet.
# YGG_ADDR=127.0.0.1:4747

# Where ygg keeps its database and run folders. Must be an absolute path.
# Default: a "ygg" folder in your user configuration folder (on Windows,
# %APPDATA%\ygg).
# YGG_DATA_DIR=

# Log level: debug, info (default), warn or error. Logs never hold tokens.
# YGG_LOG=info

# Pause, in milliseconds, between the events of the demo agent, so a task
# visibly streams. Default 250; 0 for no pause.
# YGG_MOCK_DELAY_MS=250

# --- Git hosts (GH-01, GH-02, GH-04) ------------------------------------------
# ygg reads merge requests, pipelines and your MR inbox from your git hosts. It
# only reads: it never writes to a host.
#
# Put these lines in "<data dir>/.env" (or point YGG_ENV_FILE at any file); the
# same names in the process environment win over the file. A ".env" inside a
# repo clone is never read, because it could end up in a commit. "ygg doctor"
# prints the path ygg reads.
#
# Tokens go only to the host they belong to, in a request header.
#
# github.com and gitlab.com are known without any line here. Public repos work
# without a token, with low rate limits. A token adds private repos, higher
# limits and the MR inbox.

# A self-hosted GitLab. The "read_api" scope is enough.
# YGG_HOST_1=gitlab https://git.acme.dev
# YGG_HOST_1_TOKEN=

# GitHub. A fine-grained token needs: Pull requests (read), Commit statuses
# (read) and Actions (read). Add the line only to set a token.
# YGG_HOST_2=github https://github.com
# YGG_HOST_2_TOKEN=

# Gitea (community-maintained). A token with read access to repositories.
# YGG_HOST_3=gitea https://code.example.org
# YGG_HOST_3_TOKEN=

# Use another file for the host settings instead of "<data dir>/.env".
# YGG_ENV_FILE=
