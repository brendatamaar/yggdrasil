# Yggdrasil settings. Every setting is optional.
# Copy to .env and uncomment what you need. Never commit .env.
#
# Tokens set here are used by ygg itself only. They are never passed to
# builds, dev servers, terminals, installs or agents.

# --- Server -----------------------------------------------------------------

# Listen address. Loopback IPs only (127.0.0.1 or ::1); remote access isn't
# available yet.
# YGG_ADDR=127.0.0.1:4747

# --- Planned (not read yet) -------------------------------------------------
# These are placeholders for settings that arrive in later phases. Names may
# change before they're implemented; this file will be updated when they are.

# Where ygg keeps its database, logs and artifacts.
# YGG_DATA_DIR=

# Git host tokens (Phase 2). Without a token, ygg still works with what git
# itself can reach; a token adds merge request and pipeline detail.
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# GITEA_TOKEN=
